{
  "name": "reinstate",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "content"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@reinstate/web",
    "build": "npm run build --workspace=@reinstate/web",
    "start": "npm run start --workspace=@reinstate/web",
    "lint": "npm run lint --workspace=@reinstate/web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "casecheck": "tsx scripts/casetype-lint.ts",
    "fixture": "tsx scripts/run-fixture.ts"
  },
  "devDependencies": {
    "@netlify/functions": "^2.8.2",
    "@netlify/plugin-nextjs": "^5.15.13",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3"
  }
}
