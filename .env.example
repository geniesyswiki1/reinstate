# Anthropic
ANTHROPIC_API_KEY=

# Stripe Managed Payments (web payments). Managed Payments is Stripe as merchant of record;
# it must be activated and its terms accepted at dashboard.stripe.com/settings/managed-payments.
# One price id per tier, created against a product whose tax code is Managed Payments eligible.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_AMAZON=
STRIPE_PRICE_MARKETPLACE=
STRIPE_PRICE_PAYMENTS=
STRIPE_PRICE_ADDON=

# RevenueCat (mobile payments)
REVENUECAT_WEBHOOK_SECRET=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Email
RESEND_API_KEY=

# Rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Observability
SENTRY_DSN=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Site
NEXT_PUBLIC_SITE_URL=

# Set to 1 on any deploy that is not the production site (previews, test deploys).
# robots.txt then disallows everything and every page carries noindex.
NEXT_PUBLIC_NOINDEX=

# Ops
N8N_WEBHOOK_URL=

# Alpha coupon (section 6)
ALPHA_CODE_ENABLED=true
